# ====================
# REQUIRED CONFIGURATION
# ====================

# Database Configuration (PostgreSQL)
# Examples:
#   - Neon: postgresql://user:pass@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
#   - Railway: postgresql://postgres:pass@containers-us-west.railway.app:5432/railway
#   - Render: postgresql://user:pass@dpg-abc123-a.oregon-postgres.render.com/mydb
#   - Local: postgresql://postgres:postgres@localhost:5432/mealeez
DATABASE_URL=postgresql://user:password@host:5432/database

# ====================
# OPTIONAL CONFIGURATION
# ====================

# OpenAI Configuration (for AI features: recipe import, meal suggestions)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Session Configuration (generate a secure random string)
SESSION_SECRET=your-session-secret-here-should-be-random-and-secure

# Server Configuration
PORT=5000
NODE_ENV=development

# ====================
# OPTIONAL: REPLIT AUTHENTICATION
# Only needed if deploying on Replit and want Replit Auth
# ====================
# REPL_ID=your-repl-id
# REPLIT_DOMAINS=your-replit-domain.repl.co
# ISSUER_URL=https://replit.com/oidc
